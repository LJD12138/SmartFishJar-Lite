N    lwrb_sz_t size; 		/*!< 缓冲区数据的大小。实际可用缓冲区大小比该值小 1 字节 */
N    lwrb_sz_atomic_t r_ptr; /*!< 下一个读取指针。
N                                当 `r == w` 时缓冲区为空，当 `w == r - 1` 时缓冲区为满 */
N    lwrb_sz_atomic_t w_ptr; /*!< 下一个写入指针。
N                                当 `r == w` 时缓冲区为空，当 `w == r - 1` 时缓冲区为满 */
N    lwrb_evt_fn evt_fn;     /*!< 指向事件回调函数的指针 */
N    void* arg;              /*!< 事件的自定义用户参数 */
N} lwrb_t;
